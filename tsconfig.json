{
    "compilerOptions": {
        "target": "es5",
        "module": "esnext",
        "outDir": "./dist",
        "noImplicitAny": true,
        "jsx": "react-jsx",
        "allowJs": true,
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "baseUrl": ".",
        "paths": {
            "@/*":["./src/*"]
        }
    },
    "ts-node": {
        "compilerOptions": {
            "module": "commonJS"
        }
    }
}